ed_code": "\n    \n    \n\n\n\nselect movie_id\nfrom MOVIELENS.DEV.dim_movies\nwhere movie_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-18T11:56:42.773277Z", "completed_at": "2026-08-18T11:56:42.781693Z"}, {"name": "execute", "started_at": "2026-08-18T11:56:42.782366Z", "completed_at": "2026-08-18T11:56:42.782378Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.009907245635986328, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.prime.not_null_dim_movies_movie_title.0206534c81", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect movie_title\nfrom MOVIELENS.DEV.dim_movies\nwhere movie_title is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-18T11:56:42.784523Z", "completed_at": "2026-08-18T11:56:42.787999Z"}, {"name": "execute", "started_at": "2026-08-18T11:56:42.788647Z", "completed_at": "2026-08-18T11:56:42.788658Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.005353212356567383, "adapter_response": {}, "message": null, "failures": null, "unique_id": "analysis.prime.movie_analysis", "compiled": true, "compiled_code": "WITH ratings_summary AS (\n  SELECT\n    movie_id,\n    AVG(rating) AS average_rating,\n    COUNT(*) AS total_ratings\n  FROM MOVIELENS.DEV.fct_ratings\n  GROUP BY movie_id\n  HAVING COUNT(*) > 100 -- Only movies with at least 100 ratings\n)\nSELECT\n  m.movie_title,\n  rs.average_rating,\n  rs.total_ratings\nFROM ratings_summary rs\nJOIN MOVIELENS.DEV.dim_movies m ON m.movie_id = rs.movie_id\nORDER BY rs.average_rating DESC\nLIMIT 20;", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-18T11:56:42.791256Z", "completed_at": "2026-08-18T11:56:42.794071Z"}, {"na